<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 uap10 rescap">
  <Identity Name="S.Antipin.SpanDraft" Publisher="CN=AC57B091-093F-4A75-87A8-A6DB7BD6BBFF"
            Version="__MSIX_VERSION__" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>SpanDraft</DisplayName>
    <PublisherDisplayName>S. Antipin</PublisherDisplayName>
    <Description>SpanDraft</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="de-DE" />
    <Resource Language="en-US" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>
  <Applications>
    <Application Id="SpanDraft" Executable="SpanDraft.Desktop.exe"
                 uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="SpanDraft" Description="SpanDraft"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="transparent" />
      <Extensions>
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="spandraft" Parameters="&quot;%1&quot;" MultiSelectModel="Single">
            <uap:DisplayName>SpanDraft Project</uap:DisplayName>
            <uap:Logo>Assets\ProjectFileLogo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.spandraft</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
