<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels" xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             x:Class="SpanDraft.Desktop.Views.MaterialSelectionView" x:DataType="vm:MaterialSelectionViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="MaterialRow" x:DataType="vm:MaterialSelectionItem">
      <Border Classes="selectionSurface" Margin="0,0,0,8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="4"><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Classes="bodyStrong" /><TextBlock Text="{Binding SourceLabel}" Classes="caption" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="{x:Static resources:Strings.Use}" Command="{Binding UseCommand}" AutomationProperties.Name="{x:Static resources:Strings.Use}" />
            <Button Content="{Binding EditLabel}" Command="{Binding EditCommand}" AutomationProperties.Name="{Binding EditLabel}" />
            <Button Content="{x:Static resources:Strings.Delete}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsUser}" AutomationProperties.Name="{x:Static resources:Strings.Delete}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
    <TextBlock Text="{x:Static resources:Strings.MaterialSelection}" Classes="sectionTitle" />
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <StackPanel IsVisible="{Binding HasCurrent}" Spacing="8">
          <TextBlock Text="{x:Static resources:Strings.CurrentProjectMaterial}" Classes="bodyStrong" />
          <TextBlock Text="{Binding CurrentMaterial.Name}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{x:Static resources:Strings.ContinueUsing}" Command="{Binding UseCurrentCommand}" AutomationProperties.Name="{x:Static resources:Strings.ContinueUsing}" /><Button Content="{x:Static resources:Strings.EditEntry}" Command="{Binding EditCurrentCommand}" AutomationProperties.Name="{x:Static resources:Strings.EditEntry}" /></StackPanel>
        </StackPanel>
        <TextBlock Text="{x:Static resources:Strings.BuiltInMaterials}" Classes="bodyStrong" />
        <TextBlock Text="{Binding BuiltInError}" IsVisible="{Binding HasBuiltInError}" Classes="validationMessage" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding BuiltInGroups}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MaterialGroup"><StackPanel Spacing="8"><TextBlock Text="{Binding Label}" Classes="secondary" /><ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource MaterialRow}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{x:Static resources:Strings.MyMaterials}" Classes="bodyStrong" />
        <TextBlock Text="{Binding LibraryError}" IsVisible="{Binding HasLibraryError}" Classes="validationMessage" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static resources:Strings.EmptyMaterialLibrary}" IsVisible="{Binding IsUserEmpty}" Classes="secondary" />
        <ItemsControl ItemsSource="{Binding UserEntries}" ItemTemplate="{StaticResource MaterialRow}" IsVisible="{Binding !HasLibraryError}" />
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="validationMessage" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{x:Static resources:Strings.Back}" Command="{Binding BackCommand}" AutomationProperties.Name="{x:Static resources:Strings.Back}" />
      <Button x:Name="NewMaterialButton" Content="{x:Static resources:Strings.NewMaterial}" Command="{Binding NewCommand}" Classes="primary" AutomationProperties.Name="{x:Static resources:Strings.NewMaterial}" />
    </StackPanel>
  </Grid>
</UserControl>
