<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels" xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             x:Class="SpanDraft.Desktop.Views.SegmentCardsView" x:DataType="vm:ProjectSetupViewModel">
  <StackPanel x:Name="SegmentCards" Spacing="8" VerticalAlignment="Top">
    <ItemsControl x:Name="SegmentCardList" ItemsSource="{Binding Cards}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SetupSegmentCard">
          <Border x:Name="BeamCardSurface" Classes="beamSetupCard" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock x:Name="SegmentTitle" Text="{Binding Title}" Classes="bodyStrong" IsVisible="{Binding HasSeveralSegments}" Margin="8,0,0,0" />
              <Grid x:Name="BeamAreas" ColumnDefinitions="2*,4.3*,3.7*,Auto" ColumnSpacing="8">
                <Border x:Name="LengthSurface" Padding="8">
                  <Grid x:Name="SetupLengthRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="SetupLengthLabel" Text="{x:Static resources:Strings.SetupLength}" Classes="bodyStrong" VerticalAlignment="Center" />
                    <TextBox x:Name="SetupLengthInput" Grid.Column="1" Text="{Binding LengthInput.Text, Mode=TwoWay}" Classes="inlineDimension inlineValidation"
                        Classes.error="{Binding HasLengthError}"
                        GotFocus="LengthGotFocus" LostFocus="LengthLostFocus" KeyDown="LengthKeyDown"
                        ToolTip.Tip="{Binding LengthError}" AutomationProperties.HelpText="{Binding LengthError}"
                        AutomationProperties.Name="{x:Static resources:Strings.SegmentLength}" />
                    <controls:TechnicalTextBlock x:Name="SetupLengthUnit" Grid.Column="2" Text="{Binding LengthInput.Unit}" VerticalAlignment="Center" Classes="propertyLabel" />
                  </Grid>
                </Border>
                <Button x:Name="SectionCardButton" Grid.Column="1" Classes="beamSetupSurface" Command="{Binding ChangeSectionCommand}"
                    AutomationProperties.Name="{x:Static resources:Strings.SectionSelection}">
                  <Grid RowDefinitions="Auto,*" RowSpacing="8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{x:Static resources:Strings.Section}" Classes="bodyStrong" IsVisible="{Binding HasSection}" />
                    <TextBlock Text="{x:Static resources:Strings.SectionSelection}" Classes="bodyStrong" IsVisible="{Binding !HasSection}" VerticalAlignment="Center" Grid.RowSpan="2" />
                    <Grid Grid.Row="1" IsVisible="{Binding HasSection}" ColumnDefinitions="32,*" ColumnSpacing="12" VerticalAlignment="Center">
                      <controls:SectionShapeIcon Type="{Binding SectionType}" Width="32" Height="32" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="6">
                        <controls:TechnicalTextBlock x:Name="SectionDescription" Text="{Binding SectionName}" Classes="bodyStrong" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SectionName}" />
                        <controls:TechnicalTextBlock x:Name="SectionAxisDescription" Text="{Binding AxisSummary}" Classes="propertyLabel" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AxisSummary}" />
                      </StackPanel>
                    </Grid>
                    <PathIcon Grid.Column="1" Grid.RowSpan="2" Classes="fluentIcon" Data="{StaticResource FluentIcon.ChevronRight}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button x:Name="MaterialCardButton" Grid.Column="2" Classes="beamSetupSurface" Command="{Binding ChangeMaterialCommand}"
                    AutomationProperties.Name="{x:Static resources:Strings.MaterialSelection}" AutomationProperties.HelpText="{Binding MaterialName}">
                  <Grid RowDefinitions="Auto,*" RowSpacing="8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{x:Static resources:Strings.Material}" Classes="bodyStrong" IsVisible="{Binding HasMaterial}" />
                    <TextBlock Text="{x:Static resources:Strings.SelectMaterialRequired}" Classes="bodyStrong" IsVisible="{Binding !HasMaterial}" VerticalAlignment="Center" Grid.RowSpan="2" />
                    <StackPanel Grid.Row="1" IsVisible="{Binding HasMaterial}" Spacing="6" VerticalAlignment="Center">
                      <controls:TechnicalTextBlock x:Name="MaterialDescription" Text="{Binding MaterialName}" Classes="bodyStrong" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MaterialName}" />
                      <TextBlock controls:TechnicalTextPresenter.Content="{Binding MaterialSummaryText}" Classes="propertyLabel" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MaterialSummary}" />
                    </StackPanel>
                    <PathIcon Grid.Column="1" Grid.RowSpan="2" Classes="fluentIcon" Data="{StaticResource FluentIcon.ChevronRight}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button x:Name="SegmentMenuButton" Grid.Column="3" Classes="ghost" VerticalAlignment="Center"
                    Width="{DynamicResource StandardControl}" Height="{DynamicResource StandardControl}" Click="MenuClicked"
                    AutomationProperties.Name="{x:Static resources:Strings.SegmentMenu}" ToolTip.Tip="{x:Static resources:Strings.SegmentMenu}">
                  <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.MoreHorizontal}" />
                </Button>
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Button x:Name="AddSegmentButton" Classes="secondary" Command="{Binding AddSegmentCommand}" Height="{DynamicResource StandardControl}"
          AutomationProperties.Name="{x:Static resources:Strings.SegmentAdd}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.Add}" />
          <TextBlock Text="{x:Static resources:Strings.SegmentAdd}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <controls:TechnicalTextBlock x:Name="SegmentsTotalLength" Grid.Column="2" Text="{Binding TotalLengthText}" IsVisible="{Binding ShowTotalLength}"
          Classes="propertyLabel" VerticalAlignment="Center" />
    </Grid>
    <controls:TechnicalTextBlock x:Name="SegmentErrorText" Text="{Binding SegmentError}" IsVisible="{Binding HasSegmentError}" Classes="validationMessage" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
