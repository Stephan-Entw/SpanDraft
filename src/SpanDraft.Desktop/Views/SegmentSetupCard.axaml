<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels" xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             x:Class="SpanDraft.Desktop.Views.SegmentSetupCard" x:DataType="vm:ProjectSetupViewModel">
  <Border x:Name="SegmentCardSurface" Classes="beamSetupCard" VerticalAlignment="Top" Padding="8">
    <StackPanel Spacing="8">
      <TextBlock Text="{x:Static resources:Strings.SetupSegments}" Classes="bodyStrong" />
      <Grid x:Name="SegmentHeader" ColumnDefinitions="40,1.3*,2*,2*,0.5*" ColumnSpacing="8" Margin="12,0">
        <TextBlock Text="{x:Static resources:Strings.SegmentNumber}" Classes="propertyLabel" />
        <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.SegmentRange}" Classes="propertyLabel" />
        <TextBlock Grid.Column="2" Text="{x:Static resources:Strings.Section}" Classes="propertyLabel" />
        <TextBlock Grid.Column="3" Text="{x:Static resources:Strings.Material}" Classes="propertyLabel" />
        <TextBlock Grid.Column="4" Text="{x:Static resources:Strings.BendingAxis}" Classes="propertyLabel" TextTrimming="CharacterEllipsis" />
      </Grid>
      <ListBox x:Name="SegmentList" ItemsSource="{Binding SegmentRows}" SelectedIndex="{Binding SelectedSegmentIndex, Mode=TwoWay}"
               MaxHeight="168" Padding="0" AutomationProperties.Name="{x:Static resources:Strings.SetupSegments}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SetupSegmentRow">
            <Grid ColumnDefinitions="40,1.3*,2*,2*,0.5*" ColumnSpacing="8">
              <TextBlock Text="{Binding Number}" Classes="bodyStrong" />
              <TextBlock Grid.Column="1" Text="{Binding Range}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Range}" />
              <controls:TechnicalTextBlock Grid.Column="2" Text="{Binding Section}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Section}" />
              <controls:TechnicalTextBlock Grid.Column="3" Text="{Binding Material}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Material}" />
              <TextBlock Grid.Column="4" Text="{Binding Axis}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid x:Name="SegmentActions" ColumnDefinitions="Auto,120,Auto,Auto,*,Auto,120,Auto,Auto" ColumnSpacing="8">
        <TextBlock x:Name="SplitLabel" Text="{x:Static resources:Strings.SegmentSplitAt}" Classes="bodyStrong" VerticalAlignment="Center" />
        <TextBox x:Name="SplitPositionInput" Grid.Column="1" Text="{Binding SplitInput.Text, Mode=TwoWay}" Classes="inlineDimension inlineValidation"
            Classes.error="{Binding SplitInput.HasError}" GotFocus="InputGotFocus" LostFocus="InputLostFocus" KeyDown="InputKeyDown"
            ToolTip.Tip="{Binding SplitInput.ErrorText}" AutomationProperties.Name="{x:Static resources:Strings.SegmentSplitAt}" />
        <controls:TechnicalTextBlock Grid.Column="2" Text="{Binding SplitInput.Unit}" VerticalAlignment="Center" Classes="propertyLabel" />
        <Button x:Name="SplitButton" Grid.Column="3" Content="{x:Static resources:Strings.SegmentSplit}" Command="{Binding SplitCommand}"
            Classes="secondary" Height="{DynamicResource StandardControl}" AutomationProperties.Name="{x:Static resources:Strings.SegmentSplit}" />
        <TextBlock x:Name="StartLabel" Grid.Column="5" Text="{x:Static resources:Strings.SegmentStart}" Classes="bodyStrong" VerticalAlignment="Center"
            IsVisible="{Binding CanEditBoundary}" />
        <TextBox x:Name="SegmentStartInput" Grid.Column="6" Text="{Binding BoundaryInput.Text, Mode=TwoWay}" Classes="inlineDimension inlineValidation"
            Classes.error="{Binding BoundaryInput.HasError}" IsVisible="{Binding CanEditBoundary}"
            GotFocus="InputGotFocus" LostFocus="InputLostFocus" KeyDown="InputKeyDown"
            ToolTip.Tip="{Binding BoundaryInput.ErrorText}" AutomationProperties.Name="{x:Static resources:Strings.SegmentStart}" />
        <controls:TechnicalTextBlock Grid.Column="7" Text="{Binding BoundaryInput.Unit}" VerticalAlignment="Center" Classes="propertyLabel"
            IsVisible="{Binding CanEditBoundary}" />
        <Button x:Name="RemoveSegmentButton" Grid.Column="8" Content="{x:Static resources:Strings.SegmentRemove}" Command="{Binding RemoveSegmentCommand}"
            Classes="secondary" Height="{DynamicResource StandardControl}" AutomationProperties.Name="{x:Static resources:Strings.SegmentRemove}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
