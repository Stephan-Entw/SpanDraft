<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels" xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             x:Class="SpanDraft.Desktop.Views.MaterialEditorView" x:DataType="vm:MaterialEditorViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="MaterialInputRow" x:DataType="vm:SetupNumberInput">
      <Grid Classes="materialInputRow" ColumnDefinitions="*,128,48" RowDefinitions="Auto,Auto" ColumnSpacing="8">
        <TextBlock x:Name="MaterialInputLabel" Text="{Binding Label}" Classes="propertyLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
        <TextBox x:Name="MaterialValueInput" Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" Classes="inlineDimension" Height="34" Classes.error="{Binding ShowError}" LostFocus="NumberLostFocus" AutomationProperties.Name="{Binding InputLabel}" />
        <TextBlock x:Name="MaterialInputUnit" Grid.Column="2" Text="{Binding DisplayUnit}" Classes="propertyLabel" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Error}" IsVisible="{Binding ShowError}" Classes="validationMessage" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}">
    <StackPanel Margin="24" Spacing="24" IsEnabled="{Binding !IsBusy}">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="32">
        <StackPanel Spacing="16">
          <TextBlock Text="{x:Static resources:Strings.MaterialIdentification}" Classes="sectionTitle" />
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="120,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
              <TextBlock Text="{x:Static resources:Strings.MaterialDesignation}" Classes="propertyLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBox x:Name="MaterialNameInput" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" Classes.error="{Binding ShowNameError}" KeyDown="NameKeyDown" LostFocus="NameLostFocus" AutomationProperties.Name="{x:Static resources:Strings.MaterialDesignation}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NameError}" IsVisible="{Binding ShowNameError}" Classes="validationMessage" />
            </Grid>
            <Grid ColumnDefinitions="120,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
              <TextBlock Text="{x:Static resources:Strings.MaterialCategory}" Classes="propertyLabel" VerticalAlignment="Center" />
              <ComboBox x:Name="MaterialCategoryInput" Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static resources:Strings.MaterialCategory}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SetupChoiceLabel"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CategoryError}" IsVisible="{Binding HasCategoryError}" Classes="validationMessage" />
            </Grid>
            <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
              <TextBlock Text="{x:Static resources:Strings.MaterialNumber}" Classes="propertyLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBox x:Name="MaterialNumberInput" Grid.Column="1" Text="{Binding MaterialNumber, Mode=TwoWay}" AutomationProperties.Name="{x:Static resources:Strings.MaterialNumber}" />
            </Grid>
            <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
              <TextBlock Text="{x:Static resources:Strings.OtherStandards}" Classes="propertyLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBox x:Name="MaterialStandardsInput" Grid.Column="1" Text="{Binding OtherStandards, Mode=TwoWay}" ToolTip.Tip="{x:Static resources:Strings.OtherStandardsHint}" AutomationProperties.Name="{x:Static resources:Strings.OtherStandards}" />
            </Grid>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="16">
          <TextBlock Text="{x:Static resources:Strings.MaterialProperties}" Classes="sectionTitle" />
          <ItemsControl x:Name="MaterialPropertyInputs" ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource MaterialInputRow}" />
          <TextBlock Text="{Binding Error}" IsVisible="{Binding HasFormError}" Classes="validationMessage" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="MaterialLibraryError" Text="{Binding LibraryError}" IsVisible="{Binding HasLibraryError}" Classes="validationMessage" />
      <TextBlock Text="{x:Static resources:Strings.MaterialInLibrary}" IsVisible="{Binding IsInLibrary}" Classes="secondary" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
