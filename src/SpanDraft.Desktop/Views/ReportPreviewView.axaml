<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels"
             x:Class="SpanDraft.Desktop.Views.ReportPreviewView" x:DataType="vm:ReportPreviewViewModel"
             Focusable="True" KeyDown="PreviewKeyDown">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border x:Name="ReportToolbar" Padding="{DynamicResource ToolbarPadding}" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}" BorderThickness="{DynamicResource BottomBorder}">
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel x:Name="OutputActions" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource Space4}">
          <Button x:Name="SavePdfButton" Classes="toolbar" Click="SavePdf" IsEnabled="{Binding CanOutput}"
                  AutomationProperties.Name="{x:Static resources:Strings.ReportSavePdf}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
              <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.DocumentPdf}" Width="20" Height="20" />
              <controls:ToolbarTextPresenter>
                <TextBlock Text="{x:Static resources:Strings.ReportSavePdf}" />
              </controls:ToolbarTextPresenter>
            </StackPanel>
          </Button>
          <Button x:Name="PrintButton" Classes="toolbar" Click="PrintReport" IsEnabled="{Binding CanPrint}"
                  AutomationProperties.Name="{x:Static resources:Strings.ReportPrint}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
              <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.Print}" Width="20" Height="20" />
              <controls:ToolbarTextPresenter>
                <TextBlock Text="{x:Static resources:Strings.ReportPrint}" />
              </controls:ToolbarTextPresenter>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel x:Name="PreviewControls" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space24}">
          <StackPanel x:Name="PageNavigation" Orientation="Horizontal">
            <Button x:Name="PreviousButton" Classes="iconToolbar" Width="24" Padding="0" Command="{Binding PreviousCommand}"
                    ToolTip.Tip="{x:Static resources:Strings.ReportPrevious}" AutomationProperties.Name="{x:Static resources:Strings.ReportPrevious}">
              <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.ChevronLeft}" Width="20" Height="20" />
            </Button>
            <controls:ToolbarTextPresenter x:Name="PageValue" Width="44" Height="{DynamicResource ToolbarButton}">
              <TextBlock x:Name="PageLabel" FontSize="{DynamicResource ToolbarSize}" Text="{Binding PageLabel}" />
            </controls:ToolbarTextPresenter>
            <Button x:Name="NextButton" Classes="iconToolbar" Width="24" Padding="0" Command="{Binding NextCommand}"
                    ToolTip.Tip="{x:Static resources:Strings.ReportNext}" AutomationProperties.Name="{x:Static resources:Strings.ReportNext}">
              <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.ChevronRight}" Width="20" Height="20" />
            </Button>
          </StackPanel>
          <StackPanel x:Name="ZoomControls" Orientation="Horizontal">
            <Button x:Name="ZoomOutButton" Classes="iconToolbar" Width="24" Padding="0" Command="{Binding ZoomOutCommand}"
                    ToolTip.Tip="{x:Static resources:Strings.ReportZoomOut}" AutomationProperties.Name="{x:Static resources:Strings.ReportZoomOut}">
              <PathIcon Classes="fluentIcon" Width="16" Height="16" Data="{StaticResource FluentIcon.Subtract}" />
            </Button>
            <Grid x:Name="ZoomValue" Width="48" IsEnabled="{Binding CanOutput}">
              <controls:ToolbarTextPresenter x:Name="ZoomDisplay" Height="{DynamicResource ToolbarButton}" IsHitTestVisible="False">
                <TextBlock x:Name="ZoomLabel" FontSize="{DynamicResource ToolbarSize}" Text="{Binding ZoomLabel}"
                           Foreground="{Binding Foreground, ElementName=ZoomValueButton}" />
              </controls:ToolbarTextPresenter>
              <Button x:Name="ZoomValueButton" Classes="toolbar" HorizontalAlignment="Stretch" Padding="0" Background="Transparent" Click="EditZoom"
                      AutomationProperties.Name="{x:Static resources:Strings.Zoom}" AutomationProperties.HelpText="{Binding ZoomLabel}" />
              <TextBox x:Name="ZoomInput" IsVisible="False" MinWidth="0" TextAlignment="Center" Padding="2,0"
                       Height="{DynamicResource ToolbarButton}" KeyDown="ZoomInputKeyDown" LostFocus="ZoomInputLostFocus"
                       AutomationProperties.Name="{x:Static resources:Strings.Zoom}" />
            </Grid>
            <Button x:Name="ZoomInButton" Classes="iconToolbar" Width="24" Padding="0" Command="{Binding ZoomInCommand}"
                    ToolTip.Tip="{x:Static resources:Strings.ReportZoomIn}" AutomationProperties.Name="{x:Static resources:Strings.ReportZoomIn}">
              <PathIcon Classes="fluentIcon" Width="16" Height="16" Data="{StaticResource FluentIcon.Add}" />
            </Button>
          </StackPanel>
          <StackPanel x:Name="FitControls" Orientation="Horizontal" Spacing="{StaticResource Space4}">
            <Button x:Name="PageFitButton" Classes="iconToolbar" Command="{Binding PageFitCommand}"
                    ToolTip.Tip="{x:Static resources:Strings.ReportFit}" AutomationProperties.Name="{x:Static resources:Strings.ReportFit}">
              <PathIcon Classes="fluentIcon fluentIcon24" Data="{StaticResource FluentIcon.DocumentFit}" />
            </Button>
            <Button x:Name="PageWidthButton" Classes="iconToolbar" Command="{Binding PageWidthCommand}"
                    ToolTip.Tip="{x:Static resources:Strings.ReportPageWidth}" AutomationProperties.Name="{x:Static resources:Strings.ReportPageWidth}">
              <PathIcon Classes="fluentIcon fluentIcon24" Data="{StaticResource FluentIcon.DocumentWidth}" />
            </Button>
          </StackPanel>
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="2" HorizontalAlignment="Right" Classes="secondary" Height="{DynamicResource ToolbarButton}"
                VerticalContentAlignment="Stretch" Command="{Binding CloseCommand}"
                AutomationProperties.Name="{x:Static resources:Strings.ReportClose}">
          <controls:ToolbarTextPresenter>
            <TextBlock Text="{x:Static resources:Strings.ReportClose}" />
          </controls:ToolbarTextPresenter>
        </Button>
      </Grid>
    </Border>
    <TextBlock x:Name="ErrorText" Grid.Row="1" Margin="16,8" Classes="validationMessage" TextWrapping="Wrap"
               IsVisible="{Binding HasError}" Text="{Binding Error}" />
    <ScrollViewer x:Name="PageScroll" Grid.Row="2" Background="{DynamicResource AppBackground}"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Border x:Name="Paper" Background="White" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top">
        <controls:ReportPageControl x:Name="PageView" Width="{Binding PageWidth}" Height="{Binding PageHeight}" />
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
