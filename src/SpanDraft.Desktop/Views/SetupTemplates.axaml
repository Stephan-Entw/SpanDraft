<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels">
  <DataTemplate x:Key="SetupInput" x:DataType="vm:SetupNumberInput">
    <StackPanel Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="{Binding InputLabel}" Classes="propertyLabel" TextWrapping="Wrap" />
      <TextBox Text="{Binding Text, Mode=TwoWay}" AutomationProperties.Name="{Binding InputLabel}" />
      <TextBlock Text="{Binding Hint}" IsVisible="{Binding HasHint}" Classes="caption" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="validationMessage" TextWrapping="Wrap" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
