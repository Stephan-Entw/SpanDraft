<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels"
             xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls"
             xmlns:views="clr-namespace:SpanDraft.Desktop.Views"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             x:Class="SpanDraft.Desktop.Views.EditorView"
             x:DataType="vm:EditorViewModel" KeyDown="EditorKeyDown">
  <UserControl.Styles>
    <!-- Keep Fluent's gutter in the layout while removing all chrome and input
         when the upper editor has no scrollable range. -->
    <Style Selector="ScrollViewer#EditorScroll /template/ ScrollBar:vertical[Maximum=0]">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <!-- The compositor needs full opacity handling on the SVGs' ancestor. -->
    <Border x:Name="EditorToolbar" BorderThickness="{DynamicResource BottomBorder}" BorderBrush="{DynamicResource Border}"
            Background="{DynamicResource Surface}" Padding="{DynamicResource ToolbarPadding}"
            RenderOptions.RequiresFullOpacityHandling="True">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" VerticalAlignment="Center">
        <ToggleButton Classes="toolbar" IsChecked="{Binding IsForceTool, Mode=OneWay}" Command="{Binding ForceToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.PointForce}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <svg:Svg Classes="toolbarIcon" Path="avares://SpanDraft.Desktop/Assets/Icons/Toolbar/point-load.svg" Stretch="Uniform" />
            <TextBlock Text="{x:Static resources:Strings.PointForce}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Classes="toolbar" IsChecked="{Binding IsMomentTool, Mode=OneWay}" Command="{Binding MomentToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.Moment}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <svg:Svg Classes="toolbarIcon" Path="avares://SpanDraft.Desktop/Assets/Icons/Toolbar/point-moment.svg" Stretch="Uniform" />
            <TextBlock Text="{x:Static resources:Strings.Moment}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Classes="toolbar" IsChecked="{Binding IsDistributedLoadTool, Mode=OneWay}" Command="{Binding DistributedLoadToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.DistributedLoad}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <svg:Svg Classes="toolbarIcon" Path="avares://SpanDraft.Desktop/Assets/Icons/Toolbar/distributed-load.svg" Stretch="Uniform" />
            <TextBlock Text="{x:Static resources:Strings.DistributedLoad}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <Rectangle Width="1" Fill="{DynamicResource Border}" Margin="{DynamicResource SeparatorMargin}" />
        <ToggleButton Classes="toolbar" IsChecked="{Binding IsFixedTool, Mode=OneWay}" Command="{Binding FixedToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.FixedSupport}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <svg:Svg Classes="toolbarIcon" Path="avares://SpanDraft.Desktop/Assets/Icons/Toolbar/fixed-support.svg" Stretch="Uniform" />
            <TextBlock Text="{x:Static resources:Strings.FixedSupport}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Classes="toolbar" IsChecked="{Binding IsPinnedTool, Mode=OneWay}" Command="{Binding PinnedToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.PinnedSupport}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <svg:Svg Classes="toolbarIcon" Path="avares://SpanDraft.Desktop/Assets/Icons/Toolbar/pinned-support.svg" Stretch="Uniform" />
            <TextBlock Text="{x:Static resources:Strings.PinnedSupport}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Classes="toolbar" IsChecked="{Binding IsRollerTool, Mode=OneWay}" Command="{Binding RollerToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.RollerSupport}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <svg:Svg Classes="toolbarIcon" Path="avares://SpanDraft.Desktop/Assets/Icons/Toolbar/roller-support.svg" Stretch="Uniform" />
            <TextBlock Text="{x:Static resources:Strings.RollerSupport}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" x:Name="EditorWorkspace">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4*" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="EditorContent" RowDefinitions="Auto,*" SizeChanged="WorkspaceSizeChanged"
            Background="{DynamicResource CanvasBackground}">
        <!-- Both viewports reserve the same gutter, including when only one overflows. -->
        <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
          <controls:BeamEditorSurface x:Name="BeamSurface" VerticalAlignment="Top" />
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" x:Name="DiagramScroll" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ResultDiagrams" Spacing="{StaticResource Space16}">
            <controls:ResultDiagram Kind="TransverseDisplacement" Presentation="{Binding Presentation}"
                                    StationLayout="{Binding #BeamSurface.StationLayout}" />
            <controls:ResultDiagram Kind="ShearForce" Presentation="{Binding Presentation}"
                                    StationLayout="{Binding #BeamSurface.StationLayout}" />
            <controls:ResultDiagram Kind="BendingMoment" Presentation="{Binding Presentation}"
                                    StationLayout="{Binding #BeamSurface.StationLayout}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <views:ProjectOverviewView Grid.Column="1" />
    </Grid>
  </Grid>
</UserControl>
