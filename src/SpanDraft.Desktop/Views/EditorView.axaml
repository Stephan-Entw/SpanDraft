<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels"
             xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls"
             xmlns:views="clr-namespace:SpanDraft.Desktop.Views"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             x:Class="SpanDraft.Desktop.Views.EditorView"
             x:DataType="vm:EditorViewModel" KeyDown="EditorKeyDown">
  <UserControl.Styles>
    <Style Selector="Border#EditorToolbar :is(Button).toolbar">
      <Setter Property="Padding" Value="2,4,8,4" />
      <Setter Property="FontSize" Value="{DynamicResource SecondarySize}" />
    </Style>
    <!-- When the captions no longer fit, the load and support tools keep only their icons
         and a short label in front of each group names what the icons are. -->
    <Style Selector="TextBlock.toolbarGroupLabel">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="FontSize" Value="{DynamicResource SecondarySize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="controls|AdaptiveToolStrip:compact TextBlock.toolbarGroupLabel">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="controls|AdaptiveToolStrip:compact TextBlock.toolbarCaption">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#EditorToolbar controls|AdaptiveToolStrip:compact ToggleButton.captioned">
      <Setter Property="Width" Value="{DynamicResource ToolbarButton}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
    <Style Selector="controls|BeamEditorSurface#BeamSurface, StackPanel#ResultDiagrams">
      <Setter Property="MaxWidth" Value="1280" />
    </Style>
    <!-- Keep Fluent's gutter in the layout while removing all chrome and input
         from either viewport when only the other one has a scrollable range. -->
    <Style Selector="ScrollViewer#EditorScroll /template/ ScrollBar:vertical[Maximum=0], ScrollViewer#DiagramScroll /template/ ScrollBar:vertical[Maximum=0]">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Border x:Name="EditorToolbar" BorderThickness="{DynamicResource BottomBorder}" BorderBrush="{DynamicResource Border}"
            Background="{DynamicResource Surface}" Padding="{DynamicResource ToolbarPadding}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space8}">
        <controls:AdaptiveToolStrip Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Classes="toolbarGroupLabel" Text="{x:Static resources:Strings.Loads}" />
          <ToggleButton Classes="toolbar captioned" IsChecked="{Binding IsForceTool, Mode=OneWay}" Command="{Binding ForceToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.PointForce}"
                        ToolTip.Tip="{x:Static resources:Strings.PointForce}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Image Classes="toolbarIcon" Source="{StaticResource ToolbarIcon.PointLoad}" Stretch="Uniform" />
              <TextBlock Classes="toolbarCaption" Text="{x:Static resources:Strings.PointForce}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="toolbar captioned" IsChecked="{Binding IsMomentTool, Mode=OneWay}" Command="{Binding MomentToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.Moment}"
                        ToolTip.Tip="{x:Static resources:Strings.Moment}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Image Classes="toolbarIcon" Source="{StaticResource ToolbarIcon.PointMoment}" Stretch="Uniform" />
              <TextBlock Classes="toolbarCaption" Text="{x:Static resources:Strings.Moment}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="toolbar captioned" IsChecked="{Binding IsDistributedLoadTool, Mode=OneWay}" Command="{Binding DistributedLoadToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.DistributedLoad}"
                        ToolTip.Tip="{x:Static resources:Strings.DistributedLoad}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Image Classes="toolbarIcon" Source="{StaticResource ToolbarIcon.DistributedLoad}" Stretch="Uniform" />
              <TextBlock Classes="toolbarCaption" Text="{x:Static resources:Strings.DistributedLoad}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="SelfWeightButton" Classes="toolbar captioned" IsChecked="{Binding IsSelfWeightEnabled, Mode=OneWay}"
                        Command="{Binding ToggleSelfWeightCommand}" AutomationProperties.Name="{x:Static resources:Strings.SelfWeight}"
                        ToolTip.Tip="{x:Static resources:Strings.SelfWeight}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Image Classes="toolbarIcon" Source="{StaticResource ToolbarIcon.SelfWeight}" Stretch="Uniform" />
              <TextBlock Classes="toolbarCaption" Text="{x:Static resources:Strings.SelfWeight}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Rectangle Width="1" Fill="{DynamicResource Border}" Margin="{DynamicResource SeparatorMargin}" />
          <TextBlock Classes="toolbarGroupLabel" Text="{x:Static resources:Strings.ToolbarSupportsAndHinges}" />
          <ToggleButton Classes="toolbar captioned" IsChecked="{Binding IsFixedTool, Mode=OneWay}" Command="{Binding FixedToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.FixedSupport}"
                        ToolTip.Tip="{x:Static resources:Strings.FixedSupport}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Image Classes="toolbarIcon" Source="{StaticResource ToolbarIcon.FixedSupport}" Stretch="Uniform" />
              <TextBlock Classes="toolbarCaption" Text="{x:Static resources:Strings.ToolbarFixedSupport}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="toolbar captioned" IsChecked="{Binding IsPinnedTool, Mode=OneWay}" Command="{Binding PinnedToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.PinnedSupport}"
                        ToolTip.Tip="{x:Static resources:Strings.PinnedSupport}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Image Classes="toolbarIcon" Source="{StaticResource ToolbarIcon.PinnedSupport}" Stretch="Uniform" />
              <TextBlock Classes="toolbarCaption" Text="{x:Static resources:Strings.ToolbarPinnedSupport}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="toolbar captioned" IsChecked="{Binding IsRollerTool, Mode=OneWay}" Command="{Binding RollerToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.RollerSupport}"
                        ToolTip.Tip="{x:Static resources:Strings.RollerSupport}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Image Classes="toolbarIcon" Source="{StaticResource ToolbarIcon.RollerSupport}" Stretch="Uniform" />
              <TextBlock Classes="toolbarCaption" Text="{x:Static resources:Strings.ToolbarRollerSupport}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="toolbar captioned" IsChecked="{Binding IsSpringTool, Mode=OneWay}" Command="{Binding SpringToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.SpringSupport}"
                        ToolTip.Tip="{x:Static resources:Strings.SpringSupport}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Image Classes="toolbarIcon" Source="{StaticResource ToolbarIcon.SpringSupport}" Stretch="Uniform" />
              <TextBlock Classes="toolbarCaption" Text="{x:Static resources:Strings.ToolbarSpringSupport}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="MomentReleaseToolButton" Classes="toolbar captioned" IsChecked="{Binding IsMomentReleaseTool, Mode=OneWay}"
                        Command="{Binding MomentReleaseToolCommand}" AutomationProperties.Name="{x:Static resources:Strings.MomentRelease}"
                        ToolTip.Tip="{x:Static resources:Strings.MomentRelease}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Image Classes="toolbarIcon" Source="{StaticResource ToolbarIcon.MomentRelease}" Stretch="Uniform" />
              <TextBlock Classes="toolbarCaption" Text="{x:Static resources:Strings.MomentRelease}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Rectangle Width="1" Fill="{DynamicResource Border}" Margin="{DynamicResource SeparatorMargin}" />
          <ToggleButton x:Name="ResultProbeToolButton" Classes="toolbar"
                        IsChecked="{Binding IsResultProbeTool, Mode=OneWay}" Command="{Binding ResultProbeToolCommand}"
                        AutomationProperties.Name="{x:Static resources:Strings.ResultProbe}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Image Classes="toolbarIcon" Source="{StaticResource ToolbarIcon.Probe}" Stretch="Uniform" />
              <TextBlock Text="{x:Static resources:Strings.ResultProbe}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
        </controls:AdaptiveToolStrip>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space4}"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="ReportToolbarButton" Classes="toolbar"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ReportCommand}"
                  AutomationProperties.Name="{x:Static resources:Strings.Report}"
                  ToolTip.Tip="{x:Static resources:Strings.ReportHeading}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Grid Width="{DynamicResource ToolbarIconSize}" Height="{DynamicResource ToolbarIconSize}">
                <PathIcon Classes="fluentIcon fluentIcon24" Data="{StaticResource FluentIcon.DocumentData}"
                          Foreground="{Binding Foreground, ElementName=ReportToolbarButton}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{x:Static resources:Strings.Report}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="ProjectPropertiesToolbarButton" Classes="toolbar"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Command="{Binding ChangeProjectCommand}"
                  AutomationProperties.Name="{x:Static resources:Strings.EditProject}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
              <Grid Width="{DynamicResource ToolbarIconSize}" Height="{DynamicResource ToolbarIconSize}">
                <PathIcon Classes="fluentIcon fluentIcon20" Data="{StaticResource FluentIcon.DocumentSettings}"
                          Foreground="{Binding Foreground, ElementName=ProjectPropertiesToolbarButton}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{x:Static resources:Strings.EditProject}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" x:Name="EditorWorkspace">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="EditorContent" RowDefinitions="Auto,Auto,*" SizeChanged="WorkspaceSizeChanged"
            Background="{DynamicResource CanvasBackground}">
        <!-- Reserve matching gutters only while at least one viewport overflows. -->
        <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <controls:BeamEditorSurface x:Name="BeamSurface" VerticalAlignment="Top" />
        </ScrollViewer>
        <!-- The same hairline as the other dividers, between the beam and the results. -->
        <Border x:Name="ResultsDivider" Grid.Row="1" Height="1" Background="{DynamicResource Border}" />
        <ScrollViewer Grid.Row="2" x:Name="DiagramScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <!-- The bottom margin gives the last diagram the same room below it as between the diagrams. -->
          <StackPanel x:Name="ResultDiagrams" Spacing="{StaticResource Space16}" Margin="0,0,0,16">
            <controls:ResultDiagram Kind="TransverseDisplacement" Presentation="{Binding Presentation}"
                                    StationLayout="{Binding #BeamSurface.StationLayout}" />
            <controls:ResultDiagram Kind="ShearForce" Presentation="{Binding Presentation}"
                                    StationLayout="{Binding #BeamSurface.StationLayout}" />
            <controls:ResultDiagram Kind="BendingMoment" Presentation="{Binding Presentation}"
                                    StationLayout="{Binding #BeamSurface.StationLayout}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <views:ProjectOverviewView Grid.Column="1" />
    </Grid>
  </Grid>
</UserControl>
