<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels"
             xmlns:state="clr-namespace:SpanDraft.Desktop.State"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             xmlns:presentation="clr-namespace:SpanDraft.Desktop.Presentation"
             x:Class="SpanDraft.Desktop.Views.ProjectOverviewView"
             x:DataType="vm:EditorViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="SupportRowTemplate" x:DataType="state:ProjectOverviewItem">
      <controls:OverviewTableRow Classes="overviewRow">
        <Button Classes="ghost overviewEntityAction" Click="EntityNameClicked" ToolTip.Tip="{Binding Name}"
                AutomationProperties.Name="{Binding Name}"
                IsEnabled="{Binding !$parent[UserControl].((vm:EditorViewModel)DataContext).IsBusy}">
          <controls:TechnicalTextBlock Text="{Binding Name}" Classes="entityName" />
        </Button>
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="1" Text="{Binding Type}" Classes="text" />
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="2" Text="{Binding Position, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="number" />
        <!-- Spring details sit below the type and count for its column. They move up by the first line's vertical
             padding, so type and details follow at one line pitch; the bottom margin restores the row padding. -->
        <ItemsControl x:Name="SupportDetails" controls:OverviewTableRow.Column="1" controls:OverviewTableRow.Row="1" ItemsSource="{Binding Details}"
                      IsVisible="{Binding HasDetails}" Margin="0,-4,0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String"><controls:TechnicalTextBlock Text="{Binding, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="supportDetail" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </controls:OverviewTableRow>
    </DataTemplate>
    <DataTemplate x:Key="LoadRowTemplate" x:DataType="state:ProjectOverviewItem">
      <controls:OverviewTableRow Classes="overviewRow">
        <Button Classes="ghost overviewEntityAction" Click="EntityNameClicked" ToolTip.Tip="{Binding Name}"
                AutomationProperties.Name="{Binding Name}"
                IsEnabled="{Binding !$parent[UserControl].((vm:EditorViewModel)DataContext).IsBusy}">
          <controls:TechnicalTextBlock Text="{Binding Name}" Classes="entityName" />
        </Button>
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="1" Text="{Binding Value, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="number" />
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="2" Text="{Binding Position, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="number" />
      </controls:OverviewTableRow>
    </DataTemplate>
    <DataTemplate x:Key="MomentReleaseRowTemplate" x:DataType="state:ProjectOverviewItem">
      <controls:OverviewTableRow Classes="overviewRow">
        <Button Classes="ghost overviewEntityAction" Click="EntityNameClicked" ToolTip.Tip="{Binding Name}"
                AutomationProperties.Name="{Binding Name}"
                IsEnabled="{Binding !$parent[UserControl].((vm:EditorViewModel)DataContext).IsBusy}">
          <controls:TechnicalTextBlock Text="{Binding Name}" Classes="entityName" />
        </Button>
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="1" Text="{Binding Type}" Classes="text" />
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="2" Text="{Binding Position, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="number" />
      </controls:OverviewTableRow>
    </DataTemplate>
    <DataTemplate x:Key="MomentReleaseResultRowTemplate" x:DataType="state:ProjectOverviewReleaseResult">
      <controls:OverviewTableRow Classes="overviewRow">
        <Button Classes="ghost overviewEntityAction" Click="EntityNameClicked" ToolTip.Tip="{Binding Name}"
                AutomationProperties.Name="{Binding Name}"
                IsEnabled="{Binding !$parent[UserControl].((vm:EditorViewModel)DataContext).IsBusy}">
          <controls:TechnicalTextBlock Text="{Binding Name}" Classes="entityName" />
        </Button>
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="1" Text="{Binding RotationLeft, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="number" />
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="2" Text="{Binding RotationRight, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="number" />
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="3" Text="{Binding Shear, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="number" />
      </controls:OverviewTableRow>
    </DataTemplate>
    <DataTemplate x:Key="SegmentRowTemplate" x:DataType="state:ProjectOverviewSegment">
      <!-- A block per segment: its heading and one description that wraps like text and is never shortened. -->
      <StackPanel x:Name="SegmentBlock" Spacing="2" Margin="0,4">
        <controls:TechnicalTextBlock x:Name="SegmentBlockTitle" Text="{Binding Title}" Classes="bodyStrong" />
        <controls:TechnicalTextBlock x:Name="SegmentBlockDescription" Text="{Binding Description}" Classes="secondary" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ReactionRowTemplate" x:DataType="state:ProjectOverviewReaction">
      <controls:OverviewTableRow Classes="overviewRow">
        <!-- A shared row is not an action, but its name stays readable through this tooltip. -->
        <Border Background="Transparent" ToolTip.Tip="{Binding Name}" />
        <Button Classes="ghost overviewEntityAction" Click="EntityNameClicked" ToolTip.Tip="{Binding Name}"
                AutomationProperties.Name="{Binding Name}"
                IsHitTestVisible="{Binding IsEditable}" Focusable="{Binding IsEditable}"
                IsEnabled="{Binding !$parent[UserControl].((vm:EditorViewModel)DataContext).IsBusy}">
          <controls:TechnicalTextBlock Text="{Binding Name}" Classes="entityName" />
        </Button>
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="1" Text="{Binding Rx, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="number" />
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="2" Text="{Binding Ry, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="number" />
        <controls:TechnicalTextBlock controls:OverviewTableRow.Column="3" Text="{Binding Moment, Converter={x:Static presentation:TechnicalLineBreaks.Converter}}" Classes="number" />
      </controls:OverviewTableRow>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector=":is(TextBlock)">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.overviewRow">
      <Setter Property="ColumnSpacing" Value="{StaticResource Space12}" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="controls|OverviewTableRow.overviewRow">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector=".overviewRow :is(TextBlock)">
      <Setter Property="FontSize" Value="{DynamicResource SecondarySize}" />
    </Style>
    <Style Selector=".tableHeader :is(TextBlock)">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Border.overviewSeparator">
      <Setter Property="Height" Value="{StaticResource Space8}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector=":is(TextBlock).entityName">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.overviewEntityAction">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector=":is(TextBlock).number">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector=":is(TextBlock).text">
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector=":is(TextBlock).supportDetail">
      <Setter Property="FontSize" Value="{DynamicResource SecondarySize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="ItemsControl">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
    <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <!-- Every table sizes its own columns from its data rows (OverviewTableScope); tables share no axes. -->
      <StackPanel Margin="{DynamicResource Padding16}" Spacing="{StaticResource Space4}">
        <Grid x:Name="ProjectBlock" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space4}">
          <TextBlock Text="{x:Static resources:Strings.BeamModel}" Classes="sectionTitle" />
          <ItemsControl x:Name="SegmentTable" Grid.Row="1" ItemsSource="{Binding Overview.Segments}"
                        ItemTemplate="{StaticResource SegmentRowTemplate}" />
        </Grid>
        <StackPanel x:Name="SupportsSection" Spacing="{StaticResource Space4}" IsVisible="{Binding Overview.HasSupports}">
          <Border Classes="overviewSeparator" />
          <TextBlock Text="{x:Static resources:Strings.Supports}" Classes="sectionTitle" />
          <StackPanel>
            <controls:OverviewTableRow.Scope><controls:OverviewTableScope Alignments="LLR" /></controls:OverviewTableRow.Scope>
            <controls:OverviewTableRow Classes="overviewRow tableHeader" IsHeader="True">
              <TextBlock controls:OverviewTableRow.Column="0" Text="{x:Static resources:Strings.OverviewName}" />
              <TextBlock controls:OverviewTableRow.Column="1" Text="{x:Static resources:Strings.OverviewType}" />
              <TextBlock controls:OverviewTableRow.Column="2" Text="{Binding Overview.PositionHeader}" Classes="number" />
            </controls:OverviewTableRow>
            <ItemsControl x:Name="SupportTable" ItemsSource="{Binding Overview.Supports}" ItemTemplate="{StaticResource SupportRowTemplate}" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="MomentReleaseSection" Spacing="{StaticResource Space4}" IsVisible="{Binding Overview.HasMomentReleases}">
          <Border Classes="overviewSeparator" />
          <TextBlock Text="{x:Static resources:Strings.MomentReleases}" Classes="sectionTitle" />
          <StackPanel>
            <controls:OverviewTableRow.Scope><controls:OverviewTableScope Alignments="LLR" /></controls:OverviewTableRow.Scope>
            <controls:OverviewTableRow Classes="overviewRow tableHeader" IsHeader="True">
              <TextBlock controls:OverviewTableRow.Column="0" Text="{x:Static resources:Strings.OverviewName}" />
              <TextBlock controls:OverviewTableRow.Column="1" Text="{x:Static resources:Strings.OverviewType}" />
              <TextBlock controls:OverviewTableRow.Column="2" Text="{Binding Overview.PositionHeader}" Classes="number" />
            </controls:OverviewTableRow>
            <ItemsControl x:Name="MomentReleaseTable" ItemsSource="{Binding Overview.MomentReleases}" ItemTemplate="{StaticResource MomentReleaseRowTemplate}" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="ForceSection" Spacing="{StaticResource Space4}" IsVisible="{Binding Overview.HasForces}">
          <Border Classes="overviewSeparator" />
          <TextBlock Text="{x:Static resources:Strings.Forces}" Classes="sectionTitle" />
          <StackPanel>
            <controls:OverviewTableRow.Scope><controls:OverviewTableScope Alignments="LRR" WrapColumn="1" /></controls:OverviewTableRow.Scope>
            <controls:OverviewTableRow Classes="overviewRow tableHeader" IsHeader="True">
              <TextBlock controls:OverviewTableRow.Column="0" Text="{x:Static resources:Strings.OverviewName}" />
              <TextBlock controls:OverviewTableRow.Column="1" Text="{x:Static resources:Strings.OverviewValue}" Classes="number" />
              <TextBlock controls:OverviewTableRow.Column="2" Text="{Binding Overview.PositionHeader}" Classes="number" />
            </controls:OverviewTableRow>
            <ItemsControl x:Name="ForceTable" ItemsSource="{Binding Overview.Forces}" ItemTemplate="{StaticResource LoadRowTemplate}" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="MomentSection" Spacing="{StaticResource Space4}" IsVisible="{Binding Overview.HasMoments}">
          <Border Classes="overviewSeparator" />
          <TextBlock Text="{x:Static resources:Strings.Moments}" Classes="sectionTitle" />
          <StackPanel>
            <controls:OverviewTableRow.Scope><controls:OverviewTableScope Alignments="LRR" WrapColumn="1" /></controls:OverviewTableRow.Scope>
            <controls:OverviewTableRow Classes="overviewRow tableHeader" IsHeader="True">
              <TextBlock controls:OverviewTableRow.Column="0" Text="{x:Static resources:Strings.OverviewName}" />
              <TextBlock controls:OverviewTableRow.Column="1" Text="{x:Static resources:Strings.OverviewValue}" Classes="number" />
              <TextBlock controls:OverviewTableRow.Column="2" Text="{Binding Overview.PositionHeader}" Classes="number" />
            </controls:OverviewTableRow>
            <ItemsControl x:Name="MomentTable" ItemsSource="{Binding Overview.Moments}" ItemTemplate="{StaticResource LoadRowTemplate}" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="DistributedLoadSection" Spacing="{StaticResource Space4}" IsVisible="{Binding Overview.HasDistributedLoads}">
          <Border Classes="overviewSeparator" />
          <TextBlock Text="{x:Static resources:Strings.DistributedLoads}" Classes="sectionTitle" />
          <StackPanel>
            <controls:OverviewTableRow.Scope><controls:OverviewTableScope Alignments="LRR" WrapColumn="1" /></controls:OverviewTableRow.Scope>
            <controls:OverviewTableRow Classes="overviewRow tableHeader" IsHeader="True">
              <TextBlock controls:OverviewTableRow.Column="0" Text="{x:Static resources:Strings.OverviewName}" />
              <TextBlock controls:OverviewTableRow.Column="1" Text="{x:Static resources:Strings.OverviewValue}" Classes="number" />
              <TextBlock controls:OverviewTableRow.Column="2" Text="{Binding Overview.PositionHeader}" Classes="number" />
            </controls:OverviewTableRow>
            <ItemsControl x:Name="DistributedLoadTable" ItemsSource="{Binding Overview.DistributedLoads}" ItemTemplate="{StaticResource LoadRowTemplate}" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="ReactionsSection" Spacing="{StaticResource Space4}" IsVisible="{Binding Overview.HasReactions}">
          <Border Classes="overviewSeparator" />
          <TextBlock Text="{x:Static resources:Strings.Reactions}" Classes="sectionTitle" />
          <StackPanel>
            <controls:OverviewTableRow.Scope><controls:OverviewTableScope Alignments="LRRR" /></controls:OverviewTableRow.Scope>
            <controls:OverviewTableRow Classes="overviewRow tableHeader" IsHeader="True">
              <TextBlock controls:OverviewTableRow.Column="0" Text="{x:Static resources:Strings.Support}" />
              <TextBlock x:Name="ReactionXHeader" controls:OverviewTableRow.Column="1" controls:TechnicalTextPresenter.Content="{Binding Overview.ReactionXHeaderText}" Classes="number" />
              <TextBlock x:Name="ReactionYHeader" controls:OverviewTableRow.Column="2" controls:TechnicalTextPresenter.Content="{Binding Overview.ReactionYHeaderText}" Classes="number" />
              <TextBlock x:Name="ReactionMomentHeader" controls:OverviewTableRow.Column="3" controls:TechnicalTextPresenter.Content="{Binding Overview.ReactionMomentHeaderText}" Classes="number" />
            </controls:OverviewTableRow>
            <ItemsControl x:Name="ReactionTable" ItemsSource="{Binding Overview.Reactions}" ItemTemplate="{StaticResource ReactionRowTemplate}" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="MomentReleaseResultsSection" Spacing="{StaticResource Space4}" IsVisible="{Binding Overview.HasMomentReleaseResults}">
          <Border Classes="overviewSeparator" />
          <TextBlock Text="{x:Static resources:Strings.MomentReleaseResults}" Classes="sectionTitle" />
          <StackPanel>
            <controls:OverviewTableRow.Scope><controls:OverviewTableScope Alignments="LRRR" /></controls:OverviewTableRow.Scope>
            <controls:OverviewTableRow Classes="overviewRow tableHeader" IsHeader="True">
              <TextBlock controls:OverviewTableRow.Column="0" Text="{x:Static resources:Strings.MomentRelease}" />
              <TextBlock x:Name="RotationLeftHeader" controls:OverviewTableRow.Column="1" controls:TechnicalTextPresenter.Content="{Binding Overview.RotationLeftHeaderText}" Classes="number" />
              <TextBlock x:Name="RotationRightHeader" controls:OverviewTableRow.Column="2" controls:TechnicalTextPresenter.Content="{Binding Overview.RotationRightHeaderText}" Classes="number" />
              <TextBlock x:Name="ReleaseShearHeader" controls:OverviewTableRow.Column="3" controls:TechnicalTextPresenter.Content="{Binding Overview.ReleaseShearHeaderText}" Classes="number" />
            </controls:OverviewTableRow>
            <ItemsControl x:Name="MomentReleaseResultTable" ItemsSource="{Binding Overview.MomentReleaseResults}" ItemTemplate="{StaticResource MomentReleaseResultRowTemplate}" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="IndicatorsSection" Spacing="{StaticResource Space4}" IsVisible="{Binding Presentation.IsSuccess}">
          <Border Classes="overviewSeparator" />
          <TextBlock Text="{x:Static resources:Strings.Indicators}" Classes="sectionTitle" />
          <StackPanel x:Name="IndicatorsPanel" IsVisible="{Binding Overview.Analysis.IsSuccess}">
            <Grid Classes="overviewRow" ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Static resources:Strings.MaximumDeflection}" Classes="propertyLabel" />
              <controls:TechnicalTextBlock Grid.Column="1" Text="{Binding Overview.Analysis.Displacement}" Classes="number bodyStrong" />
            </Grid>
            <Grid Classes="overviewRow" ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Static resources:Strings.GoverningMoment}" Classes="propertyLabel" />
              <controls:TechnicalTextBlock Grid.Column="1" Text="{Binding Overview.Analysis.Moment}" Classes="number bodyStrong" />
            </Grid>
            <Grid Classes="overviewRow" ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Static resources:Strings.MaximumBendingStress}" Classes="propertyLabel" />
              <controls:TechnicalTextBlock Grid.Column="1" Text="{Binding Overview.Analysis.Stress}" Classes="number bodyStrong" />
            </Grid>
            <Grid x:Name="GoverningSegmentRow" Classes="overviewRow" ColumnDefinitions="*,Auto" IsVisible="{Binding Overview.HasSeveralSegments}">
              <TextBlock Text="{x:Static resources:Strings.ReportGoverningSegment}" Classes="propertyLabel" />
              <controls:TechnicalTextBlock Grid.Column="1" Text="{Binding Overview.Analysis.GoverningSegment}" Classes="number bodyStrong" />
            </Grid>
            <Grid Classes="overviewRow" ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Static resources:Strings.SafetyFactorLabel}" Classes="propertyLabel" />
              <controls:TechnicalTextBlock Grid.Column="1" Text="{Binding Overview.Analysis.SafetyFactor}" Classes="number bodyStrong" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
