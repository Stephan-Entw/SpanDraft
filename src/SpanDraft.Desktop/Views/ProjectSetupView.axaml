<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels" xmlns:views="clr-namespace:SpanDraft.Desktop.Views"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             x:Class="SpanDraft.Desktop.Views.ProjectSetupView" x:DataType="vm:ProjectSetupViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:MaterialSelectionViewModel}"><views:MaterialSelectionView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MaterialEditorViewModel}"><views:MaterialEditorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SectionDefinitionViewModel}"><views:SectionDefinitionView /></DataTemplate>
  </UserControl.DataTemplates>
  <Grid Background="{DynamicResource AppBackground}">
    <Grid IsVisible="{Binding IsOverview}" RowDefinitions="Auto,*">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CancelSetupButton" Content="{x:Static resources:Strings.Cancel}" Command="{Binding CancelCommand}"
                IsVisible="{Binding CanCancel}" Classes="secondary" Height="{DynamicResource PrimaryAction}" AutomationProperties.Name="{x:Static resources:Strings.Cancel}" />
            <Button x:Name="ApplySetupButton" Content="{Binding PrimaryAction}" Command="{Binding ApplyCommand}"
                Classes="primary" AutomationProperties.Name="{Binding PrimaryAction}" />
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">
          <TextBlock Text="{Binding StartupError}" IsVisible="{Binding HasStartupError}" Classes="validationMessage" TextWrapping="Wrap" />
          <TextBlock Text="{x:Static resources:Strings.SetupBeam}" Classes="sectionTitle" />
          <views:BeamSetupCard x:Name="BeamCard" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid IsVisible="{Binding !IsOverview}" RowDefinitions="Auto,*">
      <TextBlock Text="{Binding Title}" Classes="pageTitle" Margin="32,24,32,0" IsVisible="{Binding !IsSectionDefinition}" />
      <ContentControl Grid.Row="1" Content="{Binding CurrentStep}" />
    </Grid>
  </Grid>
</UserControl>
