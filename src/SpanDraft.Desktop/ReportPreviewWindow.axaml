<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
        x:Class="SpanDraft.Desktop.ReportPreviewWindow" Title="{x:Static resources:Strings.ReportHeading}"
        Width="960" Height="820" MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="12,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Left">
          <Button x:Name="PreviousButton" Content="‹" Click="PreviousPage" ToolTip.Tip="{x:Static resources:Strings.ReportPrevious}"
                  AutomationProperties.Name="{x:Static resources:Strings.ReportPrevious}" />
          <TextBlock x:Name="PageLabel" VerticalAlignment="Center" MinWidth="90" TextAlignment="Center" />
          <Button x:Name="NextButton" Content="›" Click="NextPage" ToolTip.Tip="{x:Static resources:Strings.ReportNext}"
                  AutomationProperties.Name="{x:Static resources:Strings.ReportNext}" />
          <ComboBox x:Name="ZoomPicker" SelectedIndex="0" MinWidth="130" SelectionChanged="ZoomChanged">
            <ComboBoxItem Content="{x:Static resources:Strings.ReportFit}" />
            <ComboBoxItem Content="100 %" />
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
          <Button x:Name="SavePdfButton" Content="{x:Static resources:Strings.ReportSavePdf}" Click="SavePdf" />
          <Button x:Name="PrintButton" Content="{x:Static resources:Strings.ReportPrint}" Click="PrintReport" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" Background="{DynamicResource AppBackground}"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="ViewportChanged">
      <Border x:Name="Paper" Background="White" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Image x:Name="PageImage" Stretch="Uniform" />
      </Border>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="12,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="ErrorText" Classes="validationMessage" TextWrapping="Wrap" IsVisible="False" VerticalAlignment="Center" />
        <Button x:Name="CloseButton" Grid.Column="1" Content="{x:Static resources:Strings.ReportClose}" Click="ClosePreview" />
      </Grid>
    </Border>
  </Grid>
</Window>
