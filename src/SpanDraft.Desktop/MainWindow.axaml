<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
        xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels"
        xmlns:views="clr-namespace:SpanDraft.Desktop.Views"
        x:Class="SpanDraft.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://SpanDraft.Desktop/Assets/AppIcon/SpanDraft.ico"
        Width="1300" Height="800" MinWidth="1100" MinHeight="650">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:StartPageViewModel}">
      <views:StartPageView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProjectSetupViewModel}">
      <views:ProjectSetupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EditorViewModel}">
      <views:EditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportPreviewViewModel}">
      <views:ReportPreviewView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RecoveryCenterViewModel}">
      <views:RecoveryCenterView />
    </DataTemplate>
  </Window.DataTemplates>
  <Grid RowDefinitions="Auto,Auto,*">
    <Menu x:Name="MainMenu" KeyboardNavigation.TabNavigation="None" KeyboardNavigation.IsTabStop="False">
      <MenuItem Header="{x:Static resources:Strings.File}">
        <MenuItem x:Name="NewMenuItem" Header="{x:Static resources:Strings.NewProject}" Command="{Binding NewCommand}" />
        <MenuItem x:Name="OpenMenuItem" Header="{x:Static resources:Strings.Open}" Command="{Binding OpenCommand}" />
        <MenuItem x:Name="RecoveryMenuItem" Header="{x:Static resources:Strings.RecoveryMenuItem}" Command="{Binding ShowRecoveryCommand}"
                  IsVisible="{Binding HasRecovery}" />
        <Separator />
        <MenuItem x:Name="SaveMenuItem" Header="{x:Static resources:Strings.Save}" Command="{Binding SaveCommand}" />
        <MenuItem x:Name="SaveAsMenuItem" Header="{x:Static resources:Strings.SaveAs}" Command="{Binding SaveAsCommand}" />
        <MenuItem x:Name="ReportMenuItem" Header="{x:Static resources:Strings.ReportCommand}" Command="{Binding ReportCommand}" />
        <MenuItem x:Name="CloseProjectMenuItem" Header="{x:Static resources:Strings.CloseProject}" Command="{Binding CloseProjectCommand}" />
        <Separator />
        <MenuItem x:Name="QuitMenuItem" Header="{x:Static resources:Strings.Quit}" IsEnabled="{Binding !IsWorkspaceBusy}" />
      </MenuItem>
      <MenuItem Header="{x:Static resources:Strings.Edit}">
        <MenuItem x:Name="UndoMenuItem" Header="{x:Static resources:Strings.Undo}" Command="{Binding UndoCommand}" />
        <MenuItem x:Name="RedoMenuItem" Header="{x:Static resources:Strings.Redo}" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="{x:Static resources:Strings.Settings}" IsEnabled="{Binding !IsWorkspaceBusy}" Click="ShowSettings" />
      </MenuItem>
      <MenuItem Header="{x:Static resources:Strings.Help}">
        <MenuItem x:Name="UserManualMenuItem" Header="{x:Static resources:Strings.UserManual}" Command="{Binding UserManualCommand}" />
        <MenuItem x:Name="WhatsNewMenuItem" Header="{x:Static resources:Strings.WhatsNew}" Click="ShowWhatsNew" />
        <MenuItem x:Name="DiagnosticsMenuItem" Header="{x:Static resources:Strings.Diagnostics}" Click="ShowDiagnostics" />
        <Separator />
        <MenuItem Header="{x:Static resources:Strings.About}" IsEnabled="{Binding !IsWorkspaceBusy}" Click="ShowAbout" />
      </MenuItem>
    </Menu>
    <!-- Only while the recovery of this workspace is faulted (§60); it cannot be dismissed and takes no space otherwise. -->
    <Border x:Name="RecoveryFaultedNotice" Grid.Row="1" IsVisible="{Binding IsRecoveryFaulted}" Background="{DynamicResource ErrorSubtle}"
            BorderBrush="{DynamicResource Error}" BorderThickness="0,0,0,1" Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space12}">
        <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.ErrorCircle}"
            Foreground="{DynamicResource Error}" VerticalAlignment="Center" />
        <TextBlock x:Name="RecoveryFaultedNoticeText" Grid.Column="1" Text="{x:Static resources:Strings.RecoveryFaultedNotice}"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="RecoveryFaultedRetryButton" Grid.Column="2" Command="{Binding RestoreRecoveryProtectionCommand}" Classes="secondary"
                Height="{DynamicResource StandardControl}" VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static resources:Strings.RecoveryFaultedRetry}">
          <TextBlock Text="{x:Static resources:Strings.RecoveryFaultedRetry}" />
        </Button>
      </Grid>
    </Border>
    <ContentControl x:Name="WorkspaceContent" Grid.Row="2" Content="{Binding CurrentViewModel}" IsEnabled="{Binding IsWorkspaceEditable}" />
  </Grid>
</Window>
