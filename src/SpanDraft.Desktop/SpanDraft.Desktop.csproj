<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Product>SpanDraft</Product>
    <Copyright>© 2026 Stephan Antipin</Copyright>
    <LicenseDisplayName>GNU General Public License v3</LicenseDisplayName>
    <LicenseShortName>GPL v3</LicenseShortName>
    <RepositoryUrl>https://github.com/Stephan-Entw/SpanDraft</RepositoryUrl>
    <ApplicationIcon>Assets/AppIcon/SpanDraft.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('osx-')))">
    <_MacOSDevelopmentBundle>true</_MacOSDevelopmentBundle>
    <_MacOSDevelopmentRuntimePath Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)/</_MacOSDevelopmentRuntimePath>
    <_MacOSDevelopmentBundleRoot>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/$(_MacOSDevelopmentRuntimePath)SpanDraft.app/</_MacOSDevelopmentBundleRoot>
    <OutputPath>$(_MacOSDevelopmentBundleRoot)Contents/MacOS/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SpanDraft.Core/SpanDraft.Core.csproj" />
    <ProjectReference Include="../SpanDraft.Analysis/SpanDraft.Analysis.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.13" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LicenseDisplayName" Value="$(LicenseDisplayName)" />
    <AssemblyMetadata Include="LicenseShortName" Value="$(LicenseShortName)" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="SpanDraft.Desktop.LICENSE" />
    <AvaloniaResource Include="Assets/Icons/Toolbar/*.svg" />
    <AvaloniaResource Include="Assets/AppIcon/SpanDraft.ico" />
    <AvaloniaResource Include="Assets/AppIcon/app-icon-1024.png" />
  </ItemGroup>
  <Target Name="CreateMacOSDevelopmentBundle" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(_MacOSDevelopmentBundle)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(_MacOSDevelopmentBundleRoot)Contents/Resources" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Platforms/macOS/Info.plist"
          DestinationFiles="$(_MacOSDevelopmentBundleRoot)Contents/Info.plist" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Assets/AppIcon/SpanDraft.icns"
          DestinationFiles="$(_MacOSDevelopmentBundleRoot)Contents/Resources/SpanDraft.icns" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(_MacOSDevelopmentBundleRoot)Contents/Info.plist;$(_MacOSDevelopmentBundleRoot)Contents/Resources/SpanDraft.icns" />
    </ItemGroup>
  </Target>
  <Target Name="CleanMacOSDevelopmentBundle" AfterTargets="Clean"
          Condition="'$(_MacOSDevelopmentBundle)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(_MacOSDevelopmentBundleRoot)" />
  </Target>
</Project>
