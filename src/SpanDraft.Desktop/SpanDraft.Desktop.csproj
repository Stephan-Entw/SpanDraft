<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Product>SpanDraft</Product>
    <Copyright>© 2026 Stephan Antipin</Copyright>
    <LicenseDisplayName>GNU General Public License v3</LicenseDisplayName>
    <LicenseShortName>GPL v3</LicenseShortName>
    <RepositoryUrl>https://github.com/Stephan-Entw/SpanDraft</RepositoryUrl>
    <ApplicationIcon>Assets/AppIcon/SpanDraft.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('osx-')))">
    <_MacOSDevelopmentBundle>true</_MacOSDevelopmentBundle>
    <_MacOSDevelopmentRuntimePath Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)/</_MacOSDevelopmentRuntimePath>
    <_MacOSDevelopmentBundleRoot>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/$(_MacOSDevelopmentRuntimePath)SpanDraft.app/</_MacOSDevelopmentBundleRoot>
    <OutputPath>$(_MacOSDevelopmentBundleRoot)Contents/MacOS/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SpanDraft.Tests" />
    <InternalsVisibleTo Include="SpanDraft.Desktop.Tests" />
    <InternalsVisibleTo Include="SpanDraft.Rendering.Tests" />
    <InternalsVisibleTo Include="SpanDraft.Tooling.Tests" />
    <InternalsVisibleTo Include="SpanDraft.Performance" />
    <ProjectReference Include="../SpanDraft.Core/SpanDraft.Core.csproj" />
    <ProjectReference Include="../SpanDraft.Analysis/SpanDraft.Analysis.csproj" />
    <ProjectReference Include="../SpanDraft.Reporting/SpanDraft.Reporting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.2" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LicenseDisplayName" Value="$(LicenseDisplayName)" />
    <AssemblyMetadata Include="LicenseShortName" Value="$(LicenseShortName)" />
    <EmbeddedResource Include="../../legal/license/gpl-3.0.md" LogicalName="SpanDraft.Desktop.license.gpl-3.0.md" />
    <EmbeddedResource Include="../../release-notes/de.md" LogicalName="SpanDraft.Desktop.release-notes.de.md" />
    <EmbeddedResource Include="../../release-notes/en.md" LogicalName="SpanDraft.Desktop.release-notes.en.md" />
    <EmbeddedResource Include="../../legal/privacy/de.md" LogicalName="SpanDraft.Desktop.privacy.de.md" />
    <EmbeddedResource Include="../../legal/privacy/en.md" LogicalName="SpanDraft.Desktop.privacy.en.md" />
    <EmbeddedResource Include="Libraries/material-catalog.json" LogicalName="SpanDraft.Desktop.Libraries.material-catalog.json" />
    <!-- The generated help examples (tools/SpanDraft.HelpAssets), opened by spandraft://beispiel/<id>. -->
    <EmbeddedResource Include="../../help/assets/de/examples/*.spandraft" LogicalName="SpanDraft.Desktop.Examples.%(Filename).de.spandraft" />
    <EmbeddedResource Include="../../help/assets/en/examples/*.spandraft" LogicalName="SpanDraft.Desktop.Examples.%(Filename).en.spandraft" />
    <None Include="../../THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Icons/Fluent/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <None Update="Assets/Fonts/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets/AppIcon/SpanDraft.ico" />
    <AvaloniaResource Include="Assets/AppIcon/app-icon-1024.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../help/site/**/*">
      <Link>Help/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CreateMacOSDevelopmentBundle" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(_MacOSDevelopmentBundle)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(_MacOSDevelopmentBundleRoot)Contents/Resources" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Platforms/macOS/Info.plist"
          DestinationFiles="$(_MacOSDevelopmentBundleRoot)Contents/Info.plist" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <Copy SourceFiles="Assets/AppIcon/SpanDraft.icns;Assets/ProjectFileIcon/spandraft-project.icns"
          DestinationFolder="$(_MacOSDevelopmentBundleRoot)Contents/Resources" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <!-- Refresh the bundle timestamp so macOS notices changed icon resources. -->
    <Exec Command="/usr/bin/touch &quot;$(_MacOSDevelopmentBundleRoot)&quot;" />
  </Target>
  <Target Name="CleanMacOSDevelopmentBundle" AfterTargets="Clean"
          Condition="'$(_MacOSDevelopmentBundle)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(_MacOSDevelopmentBundleRoot)" />
  </Target>
</Project>
