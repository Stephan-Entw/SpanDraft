<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Inherit the platform UI font; do not ship or force a font family. -->
  <!-- Some platform fallback glyphs extend beyond the nominal line box.
       Keep their diacritics visible, including button/menu AccessText. -->
  <Style Selector=":is(TextBlock)">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Window">
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource AppBackground}" />
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{DynamicResource PageTitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource SectionTitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body, TextBlock.bodyStrong, TextBlock.technicalValue">
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
  </Style>
  <Style Selector="TextBlock.bodyStrong, TextBlock.technicalValue">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.secondary, TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource SecondarySize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.propertyLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.technicalValue">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.validationMessage">
    <Setter Property="FontSize" Value="{DynamicResource SecondarySize}" />
    <Setter Property="Foreground" Value="{DynamicResource Error}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
