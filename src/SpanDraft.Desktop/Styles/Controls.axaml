<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls">
  <!-- Fluent scrollbars, radio buttons and checkboxes retain their native control templates. -->
  <!-- One button template for all variants, including future ToggleButton tools.
       Focus is a separate overlay: borders never move the content. -->
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton))">
    <Setter Property="Height" Value="{DynamicResource StandardControl}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXS}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="DraftContent" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <Border Name="FocusRing" IsVisible="False" IsHitTestVisible="False"
                  BorderBrush="{DynamicResource Accent}" BorderThickness="{DynamicResource FocusWidth}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)):pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)):pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource SurfacePressed}" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).primary">
    <Setter Property="Height" Value="{DynamicResource StandardControl}" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).primary:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).primary:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).secondary">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).secondary:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).secondary:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource SurfacePressed}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).ghost, :is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).toolbar, :is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).iconToolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).ghost">
    <Setter Property="Height" Value="{DynamicResource CompactControl}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).toolbar, :is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).iconToolbar">
    <Setter Property="Height" Value="{DynamicResource ToolbarButton}" />
    <Setter Property="FontSize" Value="{DynamicResource ToolbarSize}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).toolbar">
    <Setter Property="Padding" Value="{DynamicResource ToolbarButtonPadding}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).iconToolbar">
    <Setter Property="Width" Value="{DynamicResource ToolbarButton}" />
    <Setter Property="Padding" Value="{DynamicResource Padding4}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).ghost:pointerover:not(:disabled), :is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).toolbar:pointerover:not(:disabled), :is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).iconToolbar:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).ghost:pressed:not(:disabled), :is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).toolbar:pressed:not(:disabled), :is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).iconToolbar:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource SurfacePressed}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).toolbar.selected, :is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).iconToolbar.selected, ToggleButton.toolbar:checked, ToggleButton.iconToolbar:checked">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentPressed}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)):disabled">
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).toolbar:disabled, :is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).iconToolbar:disabled, :is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).ghost:disabled">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)):focus-visible /template/ Border#FocusRing">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).primary /template/ Border#FocusRing">
    <Setter Property="BorderBrush" Value="{DynamicResource TextOnAccent}" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
  </Style>
  <Style Selector="Button.axisLength">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="{DynamicResource CanvasBackground}" />
    <Setter Property="Cursor" Value="IBeam" />
  </Style>

  <!-- Keep Fluent input behavior; replace its chrome, including template states. -->
  <Style Selector="RadioButton">
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="Height" Value="{DynamicResource StandardControl}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
    <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXS}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ComboBox">
    <Style.Resources>
      <!-- Fluent's highlight has a local DynamicResource background; override
           that resource instead of trying to replace it with a style setter. -->
      <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="Transparent" />
    </Style.Resources>
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtle}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBox.inlineDimension">
    <Setter Property="Height" Value="{DynamicResource StandardControl}" />
    <Setter Property="Padding" Value="{DynamicResource InlinePadding}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox.numeric, TextBox.inlineDimension">
    <Setter Property="TextAlignment" Value="Right" />
    <!-- Avalonia 12's stretched presenter can leave the caret at its pre-arrange
         position. Size the presenter to the text to keep glyphs and caret aligned. -->
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBox.loadValue">
    <Setter Property="Padding" Value="4,0,8,0" />
  </Style>
  <Style Selector="TextBox:pointerover:not(:disabled) /template/ Border#PART_BorderElement, ComboBox:pointerover:not(:disabled) /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox.loadValue:focus-within /template/ Border#PART_BorderElement, ComboBox:focus-within /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusWidth}" />
  </Style>
  <Style Selector="ComboBox:pressed:not(:disabled) /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource SurfacePressed}" />
  </Style>
  <Style Selector="ComboBox /template/ Border#HighlightBackground, ComboBox:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusWidth}" />
  </Style>
  <Style Selector="TextBox:pointerover, TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ ContentControl#ContentPresenter, ComboBox:focus:pressed /template/ ContentControl#ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph, ComboBox:focus-visible /template/ PathIcon#DropDownGlyph, ComboBox:focus:pressed /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    <Setter Property="Padding" Value="{DynamicResource Padding4}" />
  </Style>
  <Style Selector="controls|SupportFlyout ComboBox /template/ Popup#PART_Popup">
    <Setter Property="ShouldUseOverlayLayer" Value="True" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
    <Setter Property="MinHeight" Value="{DynamicResource StandardControl}" />
    <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXS}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBox:disabled, ComboBox:disabled /template/ ContentControl#ContentPresenter, ComboBox:disabled /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement, ComboBox:disabled /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>
  <Style Selector="TextBox.error /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ErrorSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
  </Style>
  <Style Selector="TextBox.error:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="{DynamicResource FocusWidth}" />
  </Style>
  <Style Selector="TextBox.inlineValidation.error">
    <Setter Property="InnerRightContent">
      <Template>
        <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.ErrorCircle}"
                  Foreground="{DynamicResource Error}" Margin="0,0,8,0"
                  Focusable="False" IsHitTestVisible="False" />
      </Template>
    </Setter>
  </Style>

  <Style Selector="Button.inputHint">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource SecondarySize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.inputHint:pointerover, Button.inputHint:pressed">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.selectionSurface">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    <Setter Property="Padding" Value="{DynamicResource Padding24}" />
  </Style>
  <Style Selector="Border.beamSetupCard">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Button.beamSetupSurface">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.beamSetupSurface:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <!-- Keep Fluent artwork on its original artboard instead of stretching its ink bounds. -->
  <Style Selector="PathIcon.fluentIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Stretch="Uniform">
          <Canvas Width="16" Height="16">
            <Path Width="16" Height="16" Stretch="None" Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="PathIcon.fluentIcon20">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Stretch="Uniform">
          <Canvas Width="20" Height="20">
            <Path Width="20" Height="20" Stretch="None" Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="PathIcon.fluentIcon24">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Stretch="Uniform">
          <Canvas Width="24" Height="24">
            <Path Width="24" Height="24" Stretch="None" Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Image.toolbarIcon">
    <Setter Property="Width" Value="{DynamicResource ToolbarIconSize}" />
    <Setter Property="Height" Value="{DynamicResource ToolbarIconSize}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector=":is(Button):not(:is(RepeatButton)):not(RadioButton):not(CheckBox):not(:is(controls|LoadSignButton)).toolbar:disabled Image.toolbarIcon">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="controls|EngineeringIcon">
    <Setter Property="Width" Value="{DynamicResource IconSize}" />
    <Setter Property="Height" Value="{DynamicResource IconSize}" />
    <Setter Property="StrokeThickness" Value="{DynamicResource IconStroke}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="controls|BeamCanvas">
    <Setter Property="LabelFontSize" Value="{DynamicResource BodySize}" />
    <Setter Property="BeamBrush" Value="{DynamicResource BeamStroke}" />
    <Setter Property="SelfWeightBrush" Value="{DynamicResource SelfWeightStroke}" />
    <Setter Property="CanvasBackgroundBrush" Value="{DynamicResource CanvasBackground}" />
    <Setter Property="GhostBrush" Value="{DynamicResource AxisStroke}" />
    <Setter Property="AccentBrush" Value="{DynamicResource Accent}" />
    <Setter Property="ErrorBrush" Value="{DynamicResource Error}" />
  </Style>
  <Style Selector="controls|CoordinateAxisPane">
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
  </Style>
  <Style Selector="controls|ResultDiagram">
    <Setter Property="MarkerFontSize" Value="{DynamicResource SecondarySize}" />
  </Style>
  <Style Selector="controls|CoordinateAxisCanvas">
    <Setter Property="AxisBrush" Value="{DynamicResource AxisStroke}" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BottomBorder}" />
    <!-- Fluent's Menu border renders these setters and leaves its item/popup templates intact. -->
    <Setter Property="Height" Value="33" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
  </Style>
  <Style Selector="Border.workspaceHeader">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BottomBorder}" />
    <Setter Property="Padding" Value="24,16" />
    <Setter Property="MinHeight" Value="70" />
  </Style>
  <Style Selector="ListBox.materialEntries, ListBox.materialFilters">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.materialEntries ListBoxItem, ListBox.materialFilters ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXS}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="Center" CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
  </Style>
  <Style Selector="ListBox.materialFilters ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="ListBox.materialEntries ListBoxItem:pointerover /template/ ContentPresenter, ListBox.materialFilters ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>
  <Style Selector="ListBox.materialEntries ListBoxItem:selected /template/ ContentPresenter, ListBox.materialFilters ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.materialNavigation">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.materialNavigation.selected, Button.materialNavigation.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
  </Style>
  <Style Selector="controls|MaterialTableColumns.materialColumns :is(TextBlock), Grid.materialProperties :is(TextBlock)">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
  </Style>
  <Style Selector="controls|MaterialTableColumns.materialHeading :is(TextBlock)">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Grid.materialInputRow">
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="{DynamicResource FocusWidth}"
                CornerRadius="{DynamicResource RadiusXS}" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
  </Style>
  <Style Selector="Border.supportFlyout">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    <Setter Property="Padding" Value="{DynamicResource Padding16}" />
  </Style>
  <Style Selector="StackPanel.editorFlyoutFooter">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Spacing" Value="{StaticResource Space8}" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Button.dangerGhost, Button.dangerGhost:pointerover, Button.dangerGhost:pressed">
    <Setter Property="Foreground" Value="{DynamicResource Error}" />
  </Style>
  <Style Selector="controls|LoadSignButton">
    <Setter Property="Width" Value="{DynamicResource LoadSignButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource LoadSignButtonSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource LoadSignButtonSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource LoadSignButtonSize}" />
    <Setter Property="MaxWidth" Value="{DynamicResource LoadSignButtonSize}" />
    <Setter Property="MaxHeight" Value="{DynamicResource LoadSignButtonSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource LoadSignButtonRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          <Border Name="SignFocusRing" IsVisible="False" IsHitTestVisible="False"
                  BorderBrush="{DynamicResource Accent}" BorderThickness="{DynamicResource FocusWidth}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|LoadSignButton:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="controls|LoadSignButton:pressed:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource SurfacePressed}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentPressed}" />
  </Style>
  <Style Selector="controls|LoadSignButton:focus-visible /template/ Border#SignFocusRing">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="controls|LoadSignButton:disabled">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
</Styles>
