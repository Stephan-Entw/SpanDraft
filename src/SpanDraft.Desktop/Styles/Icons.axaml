<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared 24 × 24 artboard. Geometry is never stretched to individual bounds.
       Open arrowheads, 1.5 DIP strokes, round caps/joins, neutral monochrome. -->
  <StreamGeometry x:Key="PointForce">M12,3 V20 M8,16 L12,20 L16,16</StreamGeometry>
  <StreamGeometry x:Key="PointMoment">M7,19 A8,8 0 1 1 19,16 M19,11 V16 H14 M11,12 H13 M12,11 V13</StreamGeometry>
  <StreamGeometry x:Key="DistributedLoad">M4,4 H20 M4,4 V19 M1,16 L4,19 L7,16 M12,4 V19 M9,16 L12,19 L15,16 M20,4 V19 M17,16 L20,19 L23,16</StreamGeometry>
  <StreamGeometry x:Key="FixedSupport">M9,3 V21 M9,12 H22 M9,4 L3,8 M9,10 L3,14 M9,16 L3,20</StreamGeometry>
  <StreamGeometry x:Key="PinnedSupport">M12,5 L5,15 H19 Z M3,21 H21 M6,21 L9,17 M12,21 L15,17 M18,21 L21,17</StreamGeometry>
  <StreamGeometry x:Key="RollerSupport">M12,5 L5,15 H19 Z M10,18 A2,2 0 1 1 6,18 A2,2 0 1 1 10,18 M18,18 A2,2 0 1 1 14,18 A2,2 0 1 1 18,18 M3,22 H21</StreamGeometry>
  <StreamGeometry x:Key="SectionProfile">M3,3 H21 V21 H3 Z M6,6 V18 H18 V6 Z</StreamGeometry>
  <StreamGeometry x:Key="Return">M20,5 V15 H4 M9,10 L4,15 L9,20</StreamGeometry>
</ResourceDictionary>
