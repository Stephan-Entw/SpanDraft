<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls"
             x:Class="SpanDraft.Desktop.Controls.PositionReferenceRow" x:DataType="vm:PositionReferenceDraft">
  <StackPanel Spacing="{StaticResource Space4}">
    <controls:FlyoutFormRow x:Name="ReferenceChoice" IsVisible="{Binding ShowReference}">
      <TextBlock Text="{x:Static resources:Strings.PositionReference}" Classes="propertyLabel" VerticalAlignment="Center" />
      <ComboBox x:Name="ReferenceInput" Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static resources:Strings.PositionReference}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PositionReferenceOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </controls:FlyoutFormRow>
    <controls:FlyoutFormRow x:Name="PositionInfoRow" IsVisible="{Binding ShowPositionInfo}">
      <TextBlock x:Name="PositionInfo" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PositionInfo}" Classes="propertyLabel" />
    </controls:FlyoutFormRow>
    <CheckBox x:Name="HoldEndInput" Content="{Binding HoldEndLabel}" IsChecked="{Binding HoldEnd, Mode=TwoWay}"
              IsVisible="{Binding CanHoldEnd}" />
  </StackPanel>
</UserControl>
