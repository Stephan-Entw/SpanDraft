<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             x:Class="SpanDraft.Desktop.Controls.SupportFlyout"
             x:DataType="vm:EditorViewModel" KeyDown="FlyoutKeyDown" KeyboardNavigation.TabNavigation="Cycle">
  <Border Classes="supportFlyout" Width="320">
    <StackPanel Spacing="{StaticResource Space12}">
      <TextBlock Text="{x:Static resources:Strings.Support}" Classes="bodyStrong" />
      <StackPanel Spacing="{StaticResource Space4}">
        <TextBlock Text="{x:Static resources:Strings.SupportTypeLabel}" Classes="propertyLabel" />
        <ComboBox x:Name="TypeInput" DropDownClosed="TypeDropDownClosed" ItemsSource="{x:Static vm:SupportDraftViewModel.Types}"
                  SelectedItem="{Binding SupportDraft.SelectedType, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static resources:Strings.SupportTypeLabel}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SupportTypeOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Spacing="{StaticResource Space4}">
        <TextBlock Text="{x:Static resources:Strings.Position}" Classes="propertyLabel" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="PositionInput" Text="{Binding SupportDraft.PositionText, Mode=TwoWay}"
                   Classes.error="{Binding SupportDraft.HasError}"
                   AutomationProperties.Name="{x:Static resources:Strings.Position}" />
          <TextBlock Grid.Column="1" Text="mm" Margin="{DynamicResource UnitMargin}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding SupportDraft.ErrorText}" IsVisible="{Binding SupportDraft.HasError}"
                   Classes="validationMessage" TextWrapping="Wrap" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space8}">
        <Button Content="{x:Static resources:Strings.Delete}" Classes="ghost dangerGhost"
                IsVisible="{Binding SupportDraft.IsExisting}" Command="{Binding DeleteSupportCommand}" />
        <Button Grid.Column="2" Content="{x:Static resources:Strings.Cancel}" Classes="ghost"
                Command="{Binding CancelSupportCommand}" />
        <Button Grid.Column="3" Content="{x:Static resources:Strings.OK}" Classes="primary"
                IsEnabled="{Binding SupportDraft.IsValid}" Command="{Binding ConfirmSupportCommand}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
