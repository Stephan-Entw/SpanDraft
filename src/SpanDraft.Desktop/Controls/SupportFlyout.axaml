<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls"
             x:Class="SpanDraft.Desktop.Controls.SupportFlyout"
             x:DataType="vm:EditorViewModel" KeyDown="FlyoutKeyDown" KeyboardNavigation.TabNavigation="Cycle">
  <Border Classes="supportFlyout" MinWidth="300">
    <StackPanel Spacing="{StaticResource Space8}" Grid.IsSharedSizeScope="True">
      <StackPanel Spacing="{StaticResource Space4}">
        <controls:FlyoutFormRow>
          <TextBlock Text="{x:Static resources:Strings.EntityNameLabel}" Classes="propertyLabel" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" x:Name="NameInput" Text="{Binding SupportDraft.NameText, Mode=TwoWay}" Classes.error="{Binding SupportDraft.HasNameError}"
                   AutomationProperties.Name="{x:Static resources:Strings.EntityNameLabel}" />
        </controls:FlyoutFormRow>
        <controls:TechnicalTextBlock Text="{Binding SupportDraft.NameError}" IsVisible="{Binding SupportDraft.HasNameError}"
                   Classes="validationMessage" TextWrapping="Wrap" />
      </StackPanel>
      <controls:FlyoutFormRow>
        <TextBlock Text="{x:Static resources:Strings.SupportTypeLabel}" Classes="propertyLabel" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" x:Name="TypeInput" DropDownClosed="TypeDropDownClosed" ItemsSource="{Binding SupportDraft.Types}"
                  SelectedItem="{Binding SupportDraft.SelectedType, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static resources:Strings.SupportTypeLabel}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SupportTypeOption"><controls:TechnicalTextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </controls:FlyoutFormRow>
      <StackPanel x:Name="SpringSection" Spacing="{StaticResource Space4}" IsVisible="{Binding SupportDraft.IsSpring}">
        <StackPanel Spacing="{StaticResource Space4}" IsVisible="{Binding SupportDraft.HasTranslational}">
          <controls:FlyoutFormRow>
            <TextBlock x:Name="TranslationalLabel" controls:TechnicalTextPresenter.Content="{Binding SupportDraft.TranslationalLabel}"
                       Classes="propertyLabel" VerticalAlignment="Center" />
            <TextBox Classes="numeric" Grid.Column="1" x:Name="TranslationalInput" Text="{Binding SupportDraft.TranslationalText, Mode=TwoWay}"
                     Classes.error="{Binding SupportDraft.HasTranslationalError}"
                     AutomationProperties.Name="{x:Static resources:Strings.SpringTranslationalName}" />
            <controls:TechnicalTextBlock Grid.Column="2" x:Name="TranslationalUnit" Text="{Binding SupportDraft.TranslationalUnit}" VerticalAlignment="Center" Classes="propertyLabel" />
          </controls:FlyoutFormRow>
          <controls:TechnicalTextBlock Text="{Binding SupportDraft.TranslationalError}" IsVisible="{Binding SupportDraft.HasTranslationalError}"
                     Classes="validationMessage" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="{StaticResource Space4}" IsVisible="{Binding SupportDraft.HasRotational}">
          <controls:FlyoutFormRow>
            <TextBlock x:Name="RotationalLabel" controls:TechnicalTextPresenter.Content="{Binding SupportDraft.RotationalLabel}"
                       Classes="propertyLabel" VerticalAlignment="Center" />
            <TextBox Classes="numeric" Grid.Column="1" x:Name="RotationalInput" Text="{Binding SupportDraft.RotationalText, Mode=TwoWay}"
                     Classes.error="{Binding SupportDraft.HasRotationalError}"
                     AutomationProperties.Name="{x:Static resources:Strings.SpringRotationalName}" />
            <controls:TechnicalTextBlock Grid.Column="2" x:Name="RotationalUnit" Text="{Binding SupportDraft.RotationalUnit}" VerticalAlignment="Center" Classes="propertyLabel" />
          </controls:FlyoutFormRow>
          <controls:TechnicalTextBlock Text="{Binding SupportDraft.RotationalError}" IsVisible="{Binding SupportDraft.HasRotationalError}"
                     Classes="validationMessage" TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox x:Name="RigidTranslationToggle" Content="{x:Static resources:Strings.SpringRigidTranslationLabel}"
                  IsChecked="{Binding SupportDraft.RigidTranslation, Mode=TwoWay}" IsVisible="{Binding SupportDraft.CanRigidTranslation}"
                  AutomationProperties.Name="{x:Static resources:Strings.SpringRigidTranslationLabel}" />
      </StackPanel>
      <StackPanel Spacing="{StaticResource Space4}">
        <controls:FlyoutFormRow>
          <TextBlock controls:TechnicalTextPresenter.Content="{Binding SupportDraft.PositionLabel}" Classes="propertyLabel" VerticalAlignment="Center" />
          <TextBox Classes="numeric" Grid.Column="1" x:Name="PositionInput" Text="{Binding SupportDraft.PositionText, Mode=TwoWay}"
                   Classes.error="{Binding SupportDraft.HasError}"
                   AutomationProperties.Name="{Binding SupportDraft.PositionLabel.PlainText}" />
          <controls:TechnicalTextBlock Grid.Column="2" x:Name="PositionUnit" Text="{Binding SupportDraft.PositionUnit}" VerticalAlignment="Center" Classes="propertyLabel" />
        </controls:FlyoutFormRow>
        <controls:PositionReferenceRow x:Name="PositionReference" DataContext="{Binding SupportDraft.Reference}" />
        <controls:TechnicalTextBlock Text="{Binding SupportDraft.ErrorText}" IsVisible="{Binding SupportDraft.HasError}"
                   Classes="validationMessage" TextWrapping="Wrap" />
        <controls:TechnicalTextBlock Text="{Binding SupportFeedback}" IsVisible="{Binding HasSupportFeedback}"
                   Classes="validationMessage" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel x:Name="Footer" Classes="editorFlyoutFooter">
        <Button x:Name="DeleteAction" Content="{x:Static resources:Strings.Delete}" Classes="ghost dangerGhost"
                IsVisible="{Binding SupportDraft.IsExisting}" Command="{Binding DeleteSupportCommand}" />
        <Button x:Name="CancelAction" Content="{x:Static resources:Strings.Cancel}" Classes="secondary"
                Command="{Binding CancelSupportCommand}" />
        <Button x:Name="ConfirmAction" Classes="primary"
                AutomationProperties.Name="{x:Static resources:Strings.OK}"
                IsEnabled="{Binding SupportDraft.IsValid}" Command="{Binding ConfirmSupportCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <TextBlock Text="{x:Static resources:Strings.OK}" VerticalAlignment="Center" />
            <controls:EngineeringIcon Data="{StaticResource Return}" Width="16" Height="16" StrokeThickness="2.25"
                                      VerticalAlignment="Center" IsHitTestVisible="False" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
