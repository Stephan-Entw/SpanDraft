<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls"
             x:Class="SpanDraft.Desktop.Controls.SelfWeightFlyout"
             x:DataType="vm:EditorViewModel" KeyDown="FlyoutKeyDown" KeyboardNavigation.TabNavigation="Cycle">
  <UserControl.Styles>
    <!-- Read-only values start where the text of the input fields in the other flyouts starts
         (field border + ControlPadding), so they keep the same distance from the labels. -->
    <Style Selector="controls|FlyoutFormRow > TextBlock.bodyStrong">
      <Setter Property="Margin" Value="13,0,0,0" />
    </Style>
  </UserControl.Styles>
  <Border Classes="supportFlyout" MinWidth="300">
    <StackPanel Spacing="{StaticResource Space8}">
      <StackPanel Grid.IsSharedSizeScope="True">
        <controls:FlyoutFormRow MinHeight="{DynamicResource StandardControl}">
          <TextBlock x:Name="WeightTitle" Text="{x:Static resources:Strings.SelfWeight}" Classes="propertyLabel" VerticalAlignment="Center" />
          <TextBlock x:Name="WeightValue" Grid.Column="1" Grid.ColumnSpan="2" Classes="bodyStrong" HorizontalAlignment="Left" VerticalAlignment="Center"
                     controls:TechnicalTextPresenter.Content="{Binding SelfWeightValue}" />
        </controls:FlyoutFormRow>
        <controls:FlyoutFormRow MinHeight="{DynamicResource StandardControl}">
          <TextBlock x:Name="AreaTitle" Text="{x:Static resources:Strings.SectionDefinitionArea}" Classes="propertyLabel" VerticalAlignment="Center" />
          <TextBlock x:Name="AreaValue" Grid.Column="1" Grid.ColumnSpan="2" Classes="bodyStrong" HorizontalAlignment="Left" VerticalAlignment="Center"
                     controls:TechnicalTextPresenter.Content="{Binding SelfWeightArea}" />
        </controls:FlyoutFormRow>
        <controls:FlyoutFormRow MinHeight="{DynamicResource StandardControl}">
          <TextBlock x:Name="DensityTitle" Text="{x:Static resources:Strings.MaterialDensity}" Classes="propertyLabel" VerticalAlignment="Center" />
          <TextBlock x:Name="DensityValue" Grid.Column="1" Grid.ColumnSpan="2" Classes="bodyStrong" HorizontalAlignment="Left" VerticalAlignment="Center"
                     controls:TechnicalTextPresenter.Content="{Binding SelfWeightDensity}" />
        </controls:FlyoutFormRow>
      </StackPanel>
      <StackPanel x:Name="Footer" Classes="editorFlyoutFooter">
        <Button x:Name="DeleteAction" Content="{x:Static resources:Strings.Delete}" Classes="ghost dangerGhost"
                Command="{Binding DisableSelfWeightCommand}" />
        <Button x:Name="CloseAction" Content="{x:Static resources:Strings.Close}" Classes="secondary" Click="Close" />
        <Button x:Name="VisibilityAction" Classes="primary"
                AutomationProperties.Name="{Binding SelfWeightVisibilityAction}" Command="{Binding ToggleSelfWeightVisibilityCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
            <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.EyeOff}" IsVisible="{Binding IsSelfWeightVisible}" />
            <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.Eye}" IsVisible="{Binding !IsSelfWeightVisible}" />
            <controls:TechnicalTextBlock x:Name="VisibilityText" Text="{Binding SelfWeightVisibilityAction}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
