<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpanDraft.Desktop.ViewModels"
             xmlns:resources="clr-namespace:SpanDraft.Desktop.Resources"
             xmlns:controls="clr-namespace:SpanDraft.Desktop.Controls"
             x:Class="SpanDraft.Desktop.Controls.SelfWeightFlyout"
             x:DataType="vm:EditorViewModel" KeyDown="FlyoutKeyDown" KeyboardNavigation.TabNavigation="Cycle">
  <Border Classes="supportFlyout" MinWidth="300">
    <StackPanel Spacing="{StaticResource Space8}">
      <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource Space16}"
            RowSpacing="{StaticResource Space4}" HorizontalAlignment="Left">
        <TextBlock x:Name="WeightTitle" Text="{x:Static resources:Strings.SelfWeight}" />
        <TextBlock x:Name="WeightValue" Grid.Column="1" controls:TechnicalTextPresenter.Content="{Binding SelfWeightValue}" />
        <TextBlock x:Name="AreaTitle" Grid.Row="1" Text="{x:Static resources:Strings.SectionDefinitionArea}" />
        <TextBlock x:Name="AreaValue" Grid.Row="1" Grid.Column="1" controls:TechnicalTextPresenter.Content="{Binding SelfWeightArea}" />
        <TextBlock x:Name="DensityTitle" Grid.Row="2" Text="{x:Static resources:Strings.MaterialDensity}" />
        <TextBlock x:Name="DensityValue" Grid.Row="2" Grid.Column="1" controls:TechnicalTextPresenter.Content="{Binding SelfWeightDensity}" />
      </Grid>
      <StackPanel x:Name="Footer" Classes="editorFlyoutFooter">
        <Button x:Name="DeleteAction" Content="{x:Static resources:Strings.Delete}" Classes="ghost dangerGhost"
                Command="{Binding DisableSelfWeightCommand}" />
        <Button x:Name="CloseAction" Content="{x:Static resources:Strings.Close}" Classes="ghost" Click="Close" />
        <Button x:Name="VisibilityAction" Classes="primary compactSupportAction"
                AutomationProperties.Name="{Binding SelfWeightVisibilityAction}" Command="{Binding ToggleSelfWeightVisibilityCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
            <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.EyeOff}" IsVisible="{Binding IsSelfWeightVisible}" />
            <PathIcon Classes="fluentIcon" Data="{StaticResource FluentIcon.Eye}" IsVisible="{Binding !IsSelfWeightVisible}" />
            <TextBlock x:Name="VisibilityText" Text="{Binding SelfWeightVisibilityAction}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
