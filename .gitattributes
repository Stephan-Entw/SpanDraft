# Keep the generated notices byte-identical for --check on every platform.
THIRD_PARTY_NOTICES.txt text eol=lf
src/SpanDraft.Desktop/Assets/Fonts/*.txt text eol=lf

# The icon generator also checks its committed resources byte-for-byte.
src/SpanDraft.Desktop/Assets/Icons/Generated/*.axaml text eol=lf

# Validation provenance hashes the committed bytes on every platform.
validation/cases/*.json text eol=lf
validation/python/*.py text eol=lf
validation/python/requirements.txt text eol=lf

# SolverSourceSha256 hashes these checked-out bytes; keep them identical on every platform.
src/SpanDraft.Core/**/*.cs text eol=lf
src/SpanDraft.Core/**/*.csproj text eol=lf
src/SpanDraft.Solver/**/*.cs text eol=lf
src/SpanDraft.Solver/**/*.csproj text eol=lf
